{
  "name": "pomodoro-cartoon-companion",
  "productName": "Pomodoro Cartoon Companion",
  "version": "1.3.0",
  "description": "Pomodoro Cartoon Companion — Animated Taskbar Timer & AI Theme Set Studio for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron . --log-level=3",
    "settings": "electron . --open-settings --log-level=3",
    "build": "electron-packager . PomodoroCartoonCompanion --platform=win32 --arch=x64 --out=dist --overwrite --asar",
    "make-update": "node scripts/make-update.js"
  },
  "keywords": [
    "pomodoro",
    "desktop-pet",
    "taskbar",
    "cartoon",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.0"
  }
}